{   
    "cloud_run_config": {
        "name_scrap": "clinica-internacional",
        "code": "10",
        "ram": "2Gi",
        "parameters": {
            "url":"https://clinicainternacional.com.pe/api/doctors",
            "dataset":"scraping_data",
            "table_name":"clinica_internacional",
            "path_blob":"data_scraping/{dataset}/{table_name}"
            
        }
    },
    "cloud_scheduler_config": {
        "name_cloud_scheduler": "inicio-clinica-internacional",
        "description": "Scheduler para iniciar el Cloud Run de clinica internacional",
        "schedule": "0 9 * * 1-5",
        "time_zone": "America/Lima"
    }

}